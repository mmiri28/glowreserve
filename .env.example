# Copy to .env.local and fill in. Never commit the real values.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@mmiri28.com

# SMS (Twilio) — optional; SMS is skipped if these are empty
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public URL of the app (used in emails and links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protects /api/cron/release-holds if it is ever called externally.
# Holds are normally released by pg_cron inside Supabase.
CRON_SECRET=
